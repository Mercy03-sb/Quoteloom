# Quoteloom environment. ALL variables are optional.
# With none set, the app runs in simulation mode (no PayPal, no LLM).
# Copy to .env.local for local overrides. Never commit real values.

# SQLite file. Recreated and re-seeded on every boot.
DATABASE_PATH=data/quoteloom.db

# PayPal (sandbox only). Without both credentials, PAYPAL_MODE is forced to "sim".
# Used by lib/paypal.ts (sandbox orders).
PAYPAL_MODE=sim
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Gemini free tier for drafting text. Without a key, deterministic fallback is used.
# Used from a later milestone.
GEMINI_API_KEY=
GEMINI_MODEL=
